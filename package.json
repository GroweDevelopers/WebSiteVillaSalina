{
  "name": "website-villa-salina",
  "version": "1.0.0",
  "private": true,
  "description": "Sito web del ristorante Villa Salina - Moretta (CN)",
  "author": "Growe Srl <account@growe.dev>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/optimize-images.mjs && next dev",
    "build": "node scripts/optimize-images.mjs && next build && node scripts/flatten-rsc-paths.mjs && node scripts/prune-export.mjs",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run build",
    "images": "node scripts/optimize-images.mjs",
    "images:force": "node scripts/optimize-images.mjs --force",
    "prune": "node scripts/prune-export.mjs",
    "flatten": "node scripts/flatten-rsc-paths.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.4.2",
    "aos": "2.3.4",
    "bootstrap": "5.1.3",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@types/aos": "^3.0.8",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
